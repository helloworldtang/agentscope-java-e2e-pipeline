# AgentScope Java 微信公众号排版 Pipeline —— 环境变量示例
# 用法：cp .env.example .env，填入真实 key，然后 `source .env && mvn exec:java`

# 必填：DeepSeek API Key
export DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# 可选：DeepSeek 接口地址（默认 https://api.deepseek.com）
export DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：模型名（默认 deepseek-chat；想用推理模型可改 deepseek-reasoner）
export DEEPSEEK_MODEL=deepseek-chat

# 可选：闭环投递公众号草稿箱（不设则只产出本地 article.html，不投递）
# 设为公众号名即启用 publish_to_wechat 工具：ailang / danxin / mingdeng
# export PUBLISH_ACCOUNT=ailang

# 前置依赖：exomind CLI（提供 MCP 服务，投递也复用其凭据 ~/.exomind/config.json）
#   - 已安装：which exomind  →  /opt/homebrew/bin/exomind
#   - 暴露的 MCP 工具：query / search（本 pipeline 的 tools.json 已 enableTools 限定这两个）
